diff --git a/source/backend/qnn/execution/QNNPermute.cpp b/source/backend/qnn/execution/QNNPermute.cpp
index 79e6e69..ba5cc3c 100644
--- a/source/backend/qnn/execution/QNNPermute.cpp
+++ b/source/backend/qnn/execution/QNNPermute.cpp
@@ -39,12 +39,38 @@ ErrorCode QNNPermute::onEncode(const std::vector<Tensor *> &inputs, const std::v
             mapRaw[i] = (uint32_t)index;
         }
     } else {
-        auto permutation = inputs[1]->host<int32_t>();
-        for (int i = 0; i < dim; i++) {
-            mapRaw[i] = (uint32_t)permutation[i];
+        if (inputs.size() > 1 && inputs[1] != nullptr) {
+            auto permutation = inputs[1]->host<int32_t>();
+            if (permutation != nullptr) {
+                for (int i = 0; i < dim; i++) {
+                    mapRaw[i] = (uint32_t)permutation[i];
+                }
+            } else {
+                MNN_ERROR("MNN_QNN: Transpose inputs[1]->host is null!\n");
+            }
+        } else {
+            MNN_ERROR("MNN_QNN: Transpose inputs.size() <= 1!\n");
         }
     }
+    std::string permStr = "";
+    for (auto p : mapRaw) permStr += std::to_string(p) + ",";
+    MNN_PRINT("MNN_QNN: Transpose dim=%d perm=[%s] inRank=%d\n", dim, permStr.c_str(), (int)inputs[0]->shape().size());
     
+    if (dim == 4 && TensorUtils::getDescribe(inputs[0])->dimensionFormat == MNN_DATA_FORMAT_NC4HW4) {
+        const int nchw_to_nhwc[4] = {0, 3, 1, 2};
+        const int nhwc_to_nchw[4] = {0, 2, 3, 1};
