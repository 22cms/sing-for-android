+        for (int m = 0; m < 4; ++m) {
+            int nchw_axis = nhwc_to_nchw[m];
+            int src_nchw_axis = mapRaw[nchw_axis];
+            nhwcPerm[m] = (uint32_t)nchw_to_nhwc[src_nchw_axis];
+        }
+        MNN_PRINT("MNN_QNN: Transpose remap NC4HW4 perm from [%u,%u,%u,%u] to NHWC [%u,%u,%u,%u]\n",
